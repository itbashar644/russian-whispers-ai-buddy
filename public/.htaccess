
RewriteEngine On

# Редирект для страниц товаров с корректной обработкой
RewriteRule ^product/([^/]+)/?$ /product/$1/ [R=301,L]
RewriteRule ^product/([^/]+)/$ /product/$1/index.html [L]

# Fallback на index.html для SPA
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
