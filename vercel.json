
{
  "rewrites": [
    {
      "source": "/product/:id",
      "destination": "/product/:id/"
    },
    {
      "source": "/product/:id/",
      "destination": "/product/:id/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/product/:id",
      "destination": "/product/:id/",
      "permanent": true
    }
  ]
}
